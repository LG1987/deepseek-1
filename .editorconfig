root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml,md}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.sql]
indent_size = 2

# Markdown 行尾双空格是换行语法，不能裁剪
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4
