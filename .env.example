# ============================================================
# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，严禁把真实密钥提交到仓库。
# 生产环境不使用 .env，改由 K8s Secret / 云 KMS 注入环境变量。
# ============================================================

# ---------- 服务 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_service
DB_USERNAME=auth
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 开发环境可用 HS256 对称密钥；生产必须改为 RS256 密钥对并由 KMS 注入
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
JWT_PRIVATE_KEY_PATH=./config/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./config/jwt-public.pem

# ---------- 邮件 / 短信（留空即禁用对应能力）----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=

# ---------- 安全策略（对应设计计划书 7.3 节）----------
AUTH_SESSION_MAX_PER_USER=5
AUTH_SESSION_MAX_PER_PLATFORM=3
AUTH_SESSION_OVERFLOW_POLICY=EVICT_OLDEST
AUTH_LOCKOUT_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_CAPTCHA_THRESHOLD=3
